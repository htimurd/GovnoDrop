# Токен бота от @BotFather
BOT_TOKEN=123456:AAAA-your-token-here

# Публичный URL твоего сервиса на Render, БЕЗ пути (проставится автоматически)
# Пример: https://govno-drop-bot.onrender.com
WEBHOOK_HOST=https://govno-drop-bot.onrender.com

# Любая случайная строка для проверки подлинности запросов от Telegram
WEBHOOK_SECRET=change-me-to-random-string

# ID администраторов через запятую (права модератора: бан, монеты, статистика, рассылка)
ADMIN_IDS=8080874290
